VITE_SUPABASE_URL=https://aioadszqatkuexxkltvr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XxScunGdJ5x-6c_5RtxMuw_pY0S-59R
VITE_SUPABASE_MAGAZINE_BUCKET=magazines
VITE_SUPABASE_EXECUTIVE_BUCKET=executives
VITE_SUPABASE_GALLERY_BUCKET=gallery

# SSLCommerz payment gateway (server-only: used by the functions in /api).
# Never add a VITE_ prefix to these, or they would be exposed in the browser.
# In production, set these in Vercel > Project > Settings > Environment Variables.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" uses sandbox.sslcommerz.com for testing; "false" uses the live gateway.
SSLCOMMERZ_SANDBOX=true
# Public site address used for payment callbacks, e.g. https://alokayoncharity.com
SITE_URL=

# Donations and receipts (server-only). The service role key is in Supabase >
# Project Settings > API Keys. It bypasses row level security: never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Resend (https://resend.com) sends the receipt emails. Verify the sending domain in Resend first.
RESEND_API_KEY=
# Sender shown to donors, e.g. Alokayon <receipts@alokayoncharity.com>
RECEIPT_FROM_EMAIL=
# Where donor replies go, e.g. alokayon2019@gmail.com
RECEIPT_REPLY_TO=
# Notified when a donor requests a hand-signed receipt (leave empty to turn off)
ADMIN_NOTIFY_EMAIL=
